# All optional. Set at build time (NEXT_PUBLIC_* values are baked into the static site).

# Canonical site URL used for canonical/hreflang/sitemap/OG links.
NEXT_PUBLIC_SITE_URL=https://thaivisaexperts.com

# Contact form via Formspree (https://formspree.io). Without it, /contact shows the email address only.
NEXT_PUBLIC_FORMSPREE_ID=

# Privacy-friendly analytics, off by default. Set ONE of these.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# Future "Get expert help" call-to-action on visa pages. Hidden unless set.
NEXT_PUBLIC_EXPERT_HELP_URL=
